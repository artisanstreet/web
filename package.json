{
  "name": "artisanstreet-web",
  "license": "BSD-3-Clause",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Artisan Street website: landing page, auth and dashboard on SvelteKit.",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter './apps/*' --filter './packages/core-client' --filter './infra' run test",
    "build": "varlock run --inject vars -- pnpm -r run build",
    "dev": "portless artisan pnpm --filter @artisanstreet/site dev"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.1",
    "portless": "0.15.5",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "varlock": "1.23.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.13.0"
  }
}
