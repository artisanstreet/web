    "svelte-effect-runtime": "5.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "svelte-check": "4.7.7",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
