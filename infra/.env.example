# ast-web infra deploy inputs. Copy to stage-specific files (NEVER commit real
# secrets; only this .example is committed). Stage files are gitignored:
#   infra/.env.prod, infra/.env.pr-42, ...
# Load via shell env or --env-file; stage itself comes from the CLI
# (--stage / ALCHEMY_STAGE), not from these files.
#
# IMPORTANT: use distinct origins per stage. Never reuse prod for previews —
# the second custom-domain attach would move ownership (separate Workers
# cannot share one custom-domain hostname).

# --- Public origins (exact https bare origins, no path) ---
# Prod example:
AST_CORE_ORIGIN=https://api.artisan.st
AST_RELAY_ORIGIN=https://relay.editor.artisan.st
AST_AUTH_ORIGIN=https://auth.artisan.st
AST_DASHBOARD_ORIGIN=https://dashboard.artisan.st
# Preview example (use instead of the above for preview stages):
# AST_CORE_ORIGIN=https://api-pr-42.example.dev
# AST_RELAY_ORIGIN=https://relay-pr-42.example.dev
# AST_AUTH_ORIGIN=https://auth-pr-42.example.dev
# AST_DASHBOARD_ORIGIN=https://dashboard-pr-42.example.dev
